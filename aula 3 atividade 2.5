#include <stdio.h>

int main(){
    int a,b,c;
    
    scanf("%d%d%d",&a,&b,&c);
    if(a == c || a == b || b == c){
        printf("couple\n");
        
    } else if((a + b == c) || (a + c == b) || (c + b) == a){
        printf("couple\n");
    } else {
        printf("not couple\n");
    }

    return 0;
}
